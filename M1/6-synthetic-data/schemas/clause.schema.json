{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claimsense/clause",
  "title": "Policy clause (citable retrieval unit)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clause_id",
    "title",
    "section",
    "text",
    "applies_to",
    "version",
    "manifest_sha256"
  ],
  "properties": {
    "clause_id": {
      "type": "string",
      "pattern": "^CLS-[A-Z]{2,4}-\\d{3}$"
    },
    "title": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 20
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "*",
          "collision",
          "glass",
          "hail",
          "theft",
          "vandalism"
        ]
      }
    },
    "version": {
      "type": "string"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "provenance: retrieved chunks must match"
    }
  }
}
