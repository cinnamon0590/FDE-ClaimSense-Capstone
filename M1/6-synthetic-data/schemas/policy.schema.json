{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claimsense/policy",
  "title": "Policy (policy administration system record)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "holder_id",
    "coverages",
    "deductible",
    "limits",
    "use_class",
    "term_start",
    "term_end",
    "term_end_rule",
    "status_field",
    "renewal"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "pattern": "^POL-AU-\\d{5}$"
    },
    "holder_id": {
      "type": "string",
      "pattern": "^CUS-[0-9A-F]{6}$"
    },
    "coverages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "liability",
          "collision",
          "comprehensive"
        ]
      }
    },
    "deductible": {
      "type": "integer",
      "minimum": 0,
      "description": "whole US dollars"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_damage",
        "liability_per_occurrence"
      ],
      "properties": {
        "physical_damage": {
          "const": "actual_cash_value"
        },
        "liability_per_occurrence": {
          "type": "integer",
          "minimum": 0,
          "description": "whole US dollars"
        }
      }
    },
    "use_class": {
      "enum": [
        "private",
        "commercial"
      ]
    },
    "term_start": {
      "type": "string",
      "format": "date"
    },
    "term_end": {
      "type": "string",
      "format": "date"
    },
    "term_end_rule": {
      "type": "string",
      "description": "when cover ends on term_end; the date check is deterministic code"
    },
    "status_field": {
      "enum": [
        "Active",
        "Pending renewal",
        "Expired",
        "Lapsed"
      ],
      "description": "can be STALE \u2014 never used to decide coverage"
    },
    "renewal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted",
        "processed"
      ],
      "properties": {
        "submitted": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "processed": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    }
  }
}
