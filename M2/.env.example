# Copy to M2/.env and fill in. M2/.env is gitignored and never committed.
# Leave OPENAI_API_KEY blank and set MOCK_BRAIN=1 to run the whole stack with no key ($0).
OPENAI_API_KEY=
MOCK_BRAIN=1
MODEL_FAST=gpt-4o-mini-2024-07-18
MODEL_SMART=gpt-4o-2024-08-06
CONSISTENCY_CHECK=1
EMBEDDING_MODEL=text-embedding-3-large
